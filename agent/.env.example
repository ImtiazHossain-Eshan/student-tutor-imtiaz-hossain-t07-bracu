# Copy this file to .env and fill in your own key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides
# TUTOR_CHAT_MODEL=gemini-3.5-flash
# TUTOR_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Groq for fast chat answers (https://console.groq.com/keys). Embeddings still use Google.
GROQ_API_KEY=
# TUTOR_GROQ_MODELS=["groq:<model id>"]
